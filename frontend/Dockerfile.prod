# syntax=docker/dockerfile:1
#
# Production frontend: build static assets, serve via nginx with /api → gateway.
# Local/dev compose continues to use Dockerfile (Vite HMR).
# Prod: docker-compose.prod.yml → dockerfile: Dockerfile.prod

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Relative /api/v1 — nginx proxies to gateway (see nginx.conf).
ENV VITE_API_BASE=/api/v1
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -qO- http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
