# ============================================================================
# AI MED — .gitignore
# ============================================================================

# ─── ⚠️ КРИТИЧНО: реальные мед.данные пациентов (ПДн) ───────────────────────
# Папка с реальными историями болезни / дневниками. НИКОГДА не коммитить!
# (см. docs/09_security_privacy.md). Корпус подаётся в ingestion локально.
Документы/
Документы/**

# Локальные сертификаты (корпоративный CA X5 и пр.) — вне git (docs/03 §9.2).
deploy/certs/
certs/
*.pem
*.crt
*.key
*.cer
*.p12

# ─── Секреты / окружение ────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ─── Go (gateway) ───────────────────────────────────────────────────────────
services/gateway/bin/
services/gateway/gateway
*.exe
*.test
*.out

# ─── Python (rag) ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / Frontend ────────────────────────────────────────────────────────
node_modules/
dist/
frontend/dist/
frontend/.vite/
*.local
# TypeScript incremental build cache (НЕ коммитить)
*.tsbuildinfo

# ─── Docker volume-данные (если монтируются локально) ───────────────────────
deploy/volumes/
postgres_data/
qdrant_data/

# ─── ОС / IDE ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.log
