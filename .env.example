# ============================================================================
# AI MED — пример переменных окружения (Этап 1, каркас).
#
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
#
# ВАЖНО: .env содержит секреты и НЕ коммитится в git (см. .gitignore,
# docs/09_security_privacy.md §6). Здесь — ТОЛЬКО плейсхолдеры.
# ============================================================================

# ─── ВНЕШНИЕ (хост) порты ───────────────────────────────────────────────────
# Это порты, публикуемые на ХОСТ-машине (host:container в docker-compose.yml).
# Меняйте их при конфликтах с уже занятыми портами на вашей машине.
# Внутри docker-сети сервисы общаются по именам и ВНУТРЕННИМ портам
# (postgres:5432, qdrant:6333 и т.д.) — эти значения НЕ зависят от переменных ниже.
#
# Дефолты намеренно смещены от «популярных» портов, т.к. на машине разработчика
# уже могут быть заняты 5432 (локальный PostgreSQL), 8000/8080/5173 (другие стеки):
#   - Postgres: 5433 вместо 5432
#   - RAG:      8001 вместо 8000
#   - Gateway:  8081 вместо 8080
#   - Frontend: 5174 вместо 5173
POSTGRES_HOST_PORT=5433
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
RAG_HOST_PORT=8001
GATEWAY_HOST_PORT=8081
FRONTEND_HOST_PORT=5174

# ─── PostgreSQL (без ПДн, docs/05) ─────────────────────────────────────────
POSTGRES_USER=aimed
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aimed

# ─── Qdrant (векторная БД, docs/03) ────────────────────────────────────────
QDRANT_COLLECTION=corpus_diaries

# ─── RAG-сервис (Python) ────────────────────────────────────────────────────
# Локальная модель эмбеддингов (docs/03 §3). Облачный embed для медкорпуса НЕ используется.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Размерность вектора модели (e5-large=1024, e5-base=768) — для коллекции Qdrant (docs/05 §3).
EMBEDDING_DIM=1024
# Устройство инференса эмбеддингов: cpu | cuda.
EMBEDDING_DEVICE=cpu

# ─── Ingestion корпуса (Этап 3, docs/03 §5) ─────────────────────────────────
# URL Go-gateway внутри docker-сети. Ingestion вызывает /api/v1/anonymize
# ДО эмбеддинга/записи в Qdrant — единый источник истины по анонимизации (docs/04 §1).
GATEWAY_URL=http://gateway:8080
# Корень корпуса ВНУТРИ контейнера rag. Папка ./Документы монтируется сюда :ro
# (см. docker-compose.yml). Реальные данные вне git (.gitignore: Документы/).
CORPUS_DIR=/data/corpus
# Охват ingestion дневников (Этап 4.1):
#   all    = весь CORPUS_DIR рекурсивно, отбор файлов-ДНЕВНИКОВ по имени/папке (ДЕФОЛТ);
#   subdir = историческое сужение до CORPUS_DIARIES_SUBDIR (фокус Этапа 3).
CORPUS_DIARIES_SCOPE=all
# Опциональное сужение охвата при CORPUS_DIARIES_SCOPE=subdir (не используется при all).
CORPUS_DIARIES_SUBDIR=02_корпус/сборник_дневников_ИБ
# Критерий «это дневник» по ИМЕНИ файла (регистронезависимый regex).
CORPUS_DIARY_NAME_RE=дневник
# Папки, ВСЕ файлы которых считаются дневниками (через запятую, регистронезависимо).
CORPUS_DIARY_DIRS=сборник_дневников_ИБ,заготовки_дневников
# НЕ-дневниковые типы документов, которые на этом этапе НЕ индексируем
# (страховка для папочной выборки; явный «дневник» в имени НЕ отсеивается).
# Точка расширения под будущие типы документов (docs/03 §11).
CORPUS_EXCLUDE_NAME_RE=первичк|первичн|эпикриз|выписк|лист[ _]*назнач|назначени|статкарт|статистическ
# Параметры чанкинга обезличенного текста (docs/03 §4).
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ─── Gateway (Go) ───────────────────────────────────────────────────────────
# Origin браузера = FRONTEND_HOST_PORT (см. блок «ВНЕШНИЕ порты» выше).
CORS_ALLOWED_ORIGIN=http://localhost:5174
# RAG-оркестрация (Этап 5): gateway проксирует генерацию в RAG-сервис.
# RAG_URL — адрес RAG внутри docker-сети (имя сервиса + внутренний порт).
RAG_URL=http://rag:8000
# Щедрый таймаут на ОДИН вызов генерации (LLM долгая, docs/03 §10), секунды.
RAG_GENERATE_TIMEOUT_S=120
# Короткий таймаут health-проверки RAG из gateway, секунды.
RAG_HEALTH_TIMEOUT_S=5

# ─── Анонимизатор / PII-гейт (Этап 2, docs/04) ──────────────────────────────
# Путь к словарям на диске. Пусто = встроенные словари (go:embed) внутри бинаря.
# Задайте, чтобы пополнять справочники учреждений/имён без пересборки образа.
ANONYMIZER_DICT_DIR=
# Адрес ЛОКАЛЬНОГО Python NER-сайдкара (Natasha), уровни 4–5 docs/04.
# Пусто = NER отключён, работает Go-only MVP. ПДн НИКОГДА не покидают периметр.
ANONYMIZER_NER_URL=
# fail-closed: при сомнении блокировать запись/отправку (docs/04 §1). По умолч. true.
ANONYMIZER_FAIL_CLOSED=true

# ─── Аутентификация (docs/09 §1) ────────────────────────────────────────────
# Секрет для подписи JWT (HS256). Сгенерируйте случайную длинную строку.
JWT_SECRET=change_me_random_long_secret

# ─── LLM: корпоративный X5 CoPilot (OpenAI-совместимый, docs/03 §9–10) ───────
# Этап 4: реальная генерация дневников. Клиент с автофолбэком моделей живёт в
# RAG-сервисе (services/rag/app/llm_client.py) и читает эти переменные.
#
# 1) Bearer-ключ X5 — ВПИСАТЬ СВОЙ. Только из ENV, НЕ коммитить в git!
X5_API_KEY=your_x5_bearer_api_key_here
# 2) base_url корпоративного шлюза (OpenAI-совместимый).
X5_BASE_URL=https://api-copilot.x5.ru/aigw/v1/
# 3) Корпоративный CA X5 (sre-vault.x5.ru) — его НЕТ в публичном certifi, поэтому
#    указываем PEM-bundle. TLS-ВЕРИФИКАЦИЯ ОСТАЁТСЯ ВКЛЮЧЁННОЙ (docs/03 §9.2).
#    КУДА ПОЛОЖИТЬ СЕРТИФИКАТ:
#      • положите PEM-файл в ./deploy/certs/x5_root_ca.pem на хосте (вне git);
#      • в docker-compose.yml для сервиса rag раскомментируйте volume:
#          - ./deploy/certs/x5_root_ca.pem:/app/certs/x5_root_ca.pem:ro
#      • значение ниже = путь ВНУТРИ контейнера.
#    Если CA не нужен (напр., публичный прокси) — оставьте пусто, тогда
#    используется стандартный системный bundle.
LLM_CA_BUNDLE=/app/certs/x5_root_ca.pem
# 4) Модели и порядок АВТОФОЛБЭКА large → medium → small (docs/03 §10).
#    Меняются без пересборки образа. Пустое значение пропускается.
LLM_MODEL_LARGE=x5-airun-large
LLM_MODEL_MEDIUM=x5-airun-medium
LLM_MODEL_SMALL=x5-airun-small
# 5) Тайм-аут одного запроса (сек), число ретраев ВНУТРИ модели, backoff.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_INITIAL_S=1.0
LLM_BACKOFF_MAX_S=30.0
# 6) Низкая температура — предсказуемость и юр.аккуратность (docs/03 §8).
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
# Эмбеддинг-модель X5 (облачная) — НЕ используется для медкорпуса (docs/03 §3),
# оставлена для справки.
# X5_EMBED_MODEL=x5-airun-embed-4b

# ─── Retrieval для генерации (docs/03 §6) ───────────────────────────────────
# Число few-shot образцов из корпуса (k=4–6 по docs/03 §6).
RETRIEVAL_TOP_K=5
